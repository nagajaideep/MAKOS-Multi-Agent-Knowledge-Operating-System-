# Copy this file to .env and fill in your own values. .env is git-ignored.

# Which model writes the short answers: gemini | claude | offline
MAKOS_LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Anthropic Claude (optional, used when MAKOS_LLM_PROVIDER=claude)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Price per million tokens used by the savings meter (USD). Check your provider's current price list.
# MAKOS_PRICE_IN_PER_M_USD=0.30
# MAKOS_PRICE_OUT_PER_M_USD=2.50
# MAKOS_USD_INR=85
